generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reserva {
  id           Int       @id @default(autoincrement())
  sala_id      Int
  responsavel  String    @db.VarChar(255)
  data_reserva DateTime  @db.Date
  hora_inicio  DateTime  @db.Time(6)
  hora_fim     DateTime  @db.Time(6)
  criado_em    DateTime? @default(now()) @db.Timestamp(6)
  sala         sala      @relation(fields: [sala_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model sala {
  id         Int       @id @default(autoincrement())
  setor_id   Int
  nome       String    @db.VarChar(255)
  capacidade Int?
  criado_em  DateTime? @default(now()) @db.Timestamp(6)
  reserva    reserva[]
  setor      setor     @relation(fields: [setor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model setor {
  id         Int       @id @default(autoincrement())
  unidade_id Int
  nome       String    @db.VarChar(255)
  criado_em  DateTime? @default(now()) @db.Timestamp(6)
  sala       sala[]
  unidade    unidade   @relation(fields: [unidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model unidade {
  id        Int       @id @default(autoincrement())
  nome      String    @db.VarChar(255)
  descricao String?
  criado_em DateTime? @default(now()) @db.Timestamp(6)
  setor     setor[]
}
